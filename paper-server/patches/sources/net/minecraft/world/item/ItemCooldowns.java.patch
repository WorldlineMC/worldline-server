+    public void worldline$load(final net.minecraft.nbt.CompoundTag root) {
+        this.tickCount = root.getIntOr("TickCount", 0);
+        this.cooldowns.clear();
+        for (final net.minecraft.nbt.Tag raw : root.getListOrEmpty("Entries")) {
+            if (!(raw instanceof net.minecraft.nbt.CompoundTag value)) {
+                throw new IllegalArgumentException("invalid cooldown entry");
+            }
+            final Identifier group = Identifier.parse(value.getStringOr("Group", ""));
+            final int start = value.getIntOr("Start", 0);
+            final int end = value.getIntOr("End", 0);
+            if (end < start || end < this.tickCount) {
+                throw new IllegalArgumentException("invalid cooldown range");
+            }
+            this.cooldowns.put(group, new ItemCooldowns.CooldownInstance(start, end));
+        }
+    }
